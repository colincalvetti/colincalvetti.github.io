---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in site.pages -%}
{%- if page.sitemap != false and page.url != '/404.html' -%}
  <url>
    <loc>{{ page.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ page.lastmod | default: page.date | default: site.time | date: '%Y-%m-%d' }}</lastmod>
  </url>
{%- endif -%}
{%- endfor -%}
</urlset>
